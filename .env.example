# Copy to .env and fill in. .env is gitignored.

# Instagram session cookie (from a logged-in browser → DevTools → Cookies → instagram.com → sessionid)
IG_SESSIONID=

# Anthropic API key for Haiku (triage) + Opus (extraction)
ANTHROPIC_API_KEY=

# Vercel token for deploys (optional locally; required in CI)
VERCEL_TOKEN=
