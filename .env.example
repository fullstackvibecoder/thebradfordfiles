# Copy to .env and fill in. .env is gitignored.

# Instagram cookies (all three, from a logged-in browser → DevTools → Cookies → instagram.com)
# These travel together; sessionid alone is not enough for paginated post listings.
IG_SESSIONID=
IG_CSRFTOKEN=
IG_DS_USER_ID=

# Anthropic API key for Haiku (triage) + Opus (extraction)
ANTHROPIC_API_KEY=

# Deepgram API key for cloud transcription (Nova 3). Falls back to local
# whisper if absent. Generate at https://console.deepgram.com — $200 free
# credit covers the entire backfill several times over.
DEEPGRAM_API_KEY=

# Vercel token for deploys (optional locally; required in CI)
VERCEL_TOKEN=

# Cloudflare Web Analytics beacon token (public — embedded in HTML).
# Get from dash.cloudflare.com → Web Analytics → your site → Snippet.
CLOUDFLARE_BEACON_TOKEN=
